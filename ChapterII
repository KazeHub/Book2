        local doorModel = hidingSpots.Parent:FindFirstChild("Door")
        local glowingPart = doorModel and doorModel:FindFirstChild("Glowing", true)
        if not glowingPart or not glowingPart:IsA("BasePart") then return end

        if isMotherNearTarget(glowingPart) then
            Window:Notify({ Title = "Chihiro Stage", Content = "Mother is within 30 studs of Door! Teleport cancelled.", Duration = 3 })
            return
        end

        hrp.CFrame = glowingPart.CFrame
        task.wait(0.1)
        if firetouchinterest then
            firetouchinterest(hrp, glowingPart, 0)
            task.wait(0.1)
            firetouchinterest(hrp, glowingPart, 1)
        end
    end
})

