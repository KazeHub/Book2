-- Global Character & Root Cache Tracking
local CachedCharacter = nil
local CachedHumanoid = nil
local CachedRootPart = nil

local function updateCharacterCache(char)
    CachedCharacter = char
    if char then
        CachedHumanoid = char:FindFirstChildOfClass("Humanoid")
        CachedRootPart = char:FindFirstChild("HumanoidRootPart")
    else
        CachedHumanoid = nil
        CachedRootPart = nil
    end
end

updateCharacterCache(LocalPlayer.Character)
LocalPlayer.CharacterAdded:Connect(updateCharacterCache)

local function getChar()
    local char = LocalPlayer.Character
    if char then return char end
    return LocalPlayer.CharacterAdded:Wait()
end

local function getHRP()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp end
    end
    return CachedRootPart
end

