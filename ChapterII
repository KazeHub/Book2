local function isMotherNearTarget(target)
    if not target then return true end
    local mother = Workspace:FindFirstChild("Mother", true)
    if not mother or not mother:IsA("Model") then return false end

    local motherPart = getModelPart(mother)
    local targetPart = getModelPart(target)
    if not motherPart or not targetPart then return false end

    local distance = (motherPart.Position - targetPart.Position).Magnitude
    return distance > 0 and distance <= 30
end

