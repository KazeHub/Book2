local autoCannon = false

local function findBallGiver()
    local battleship
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "BATTLESHIP" then
            battleship = obj
            break
        end
    end
    if not battleship then return nil end
    local ballGivers = battleship:FindFirstChild("BallGivers", true)
    return ballGivers and ballGivers:FindFirstChild("BallGiver", true)
end

local function fireBallGiver()
    local ballGiver = findBallGiver()
    if not ballGiver then return false end
    local prompt = findPrompt(ballGiver)
    if not prompt then return false end

    if fireproximityprompt then fireproximityprompt(prompt)
    else
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration, 0.1))
        prompt:InputHoldEnd()
    end
    return true
end

Boss:Toggle({
    Title = "Auto Cannon",
    Default = false,
    Callback = function(enabled)
        autoCannon = enabled
        if not enabled then return end

        task.spawn(function()
            local ballGiver = findBallGiver()
            if ballGiver then
                local hrp = getHRP()
                local part = getModelPart(ballGiver)
                if hrp and part then
                    hrp.CFrame = part.CFrame + Vector3.new(0,5,0)
                    task.wait(0.2)
                end
            end

            while autoCannon do
                fireBallGiver()
                task.wait(0.2)
            end
        end)
    end
})

local antiLaser = false
local savedCFrame = nil
local safe = false
local poisonConnection = nil
local SAFE_POSITION = CFrame.new(1978,217,-4716)

local function findNureMain()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "NureMain" then return obj end
    end
    return nil
end

local function getPoison()
    local nureMain = findNureMain()
    if not nureMain then return nil end
    return nureMain:FindFirstChild("POISON")
end

local function goSafe()
    if safe then return end
    local hrp = getHRP()
    if not hrp then return end

    savedCFrame = hrp.CFrame
    safe = true
    hrp.Anchored = false
    hrp.CFrame = SAFE_POSITION
    task.wait(0.05)
    if antiLaser and safe then hrp.Anchored = true end
end

local function goBack()
    if not safe then return end
    local hrp = getHRP()
    if not hrp then return end

    hrp.Anchored = false
    if savedCFrame then hrp.CFrame = savedCFrame end
    savedCFrame = nil
    safe = false
end

Boss:Toggle({
    Title = "Anti Laser",
    Default = false,
    Callback = function(enabled)
        antiLaser = enabled
        if not enabled then
            if poisonConnection then poisonConnection:Disconnect() poisonConnection = nil end
            goBack()
            return
        end

        task.spawn(function()
            while antiLaser do
                local poison = getPoison()
                if poison then
                    if poisonConnection then poisonConnection:Disconnect() end
                    poisonConnection = poison:GetPropertyChangedSignal("Transparency"):Connect(function()
                        if not antiLaser then return end
                        if poison.Transparency == 0.5 then goSafe()
                        elseif poison.Transparency == 1 then goBack() end
                    end)
                    if poison.Transparency == 0.5 then goSafe()
                    elseif poison.Transparency == 1 then goBack() end
                    break
                end
                task.wait(0.2)
            end
        end)
    end
})

Boss:Section("Final Form")

local autoCutlass = false

local function findNureStage2()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "NureStage2" then return obj end
    end
    return nil
end

local function findTailHitbox2()
    local nure = findNureStage2()
    return nure and nure:FindFirstChild("TailHitbox2", true)
end

local function hasTouchInterest(tail)
    if not tail then return false end
    for _, obj in ipairs(tail:GetChildren()) do
        if obj:IsA("TouchTransmitter") or obj.Name == "TouchInterest" then return true end
    end
    return false
end

local function findCutlass()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local tool = char and char:FindFirstChild("Cutlass")
    if tool and tool:IsA("Tool") then return tool end
    if backpack then
        tool = backpack:FindFirstChild("Cutlass")
        if tool and tool:IsA("Tool") then return tool end
    end
    return nil
end

local function equipCutlass()
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local cutlass = findCutlass()
    if not humanoid or not cutlass then return nil end
    if cutlass.Parent ~= char then
        humanoid:EquipTool(cutlass)
        task.wait()
    end
    return cutlass
end

Boss:Toggle({
    Title = "Auto Boss",
    Description = "Final Boss",
    Default = false,
    Callback = function(enabled)
        autoCutlass = enabled
        if not enabled then return end

        local cutlass = findCutlass()
        if not cutlass then
            autoCutlass = false
            Window:Notify({ Title = "Katana", Content = "Grab Katana First", Duration = 3 })
            return
        end

        task.spawn(function()
            while autoCutlass do
                local hrp = getHRP()
                local tail = findTailHitbox2()

                if hrp and tail then
                    cutlass = equipCutlass()
                    if cutlass then
                        if hasTouchInterest(tail) then
                            hrp.CFrame = CFrame.new(1978, 217, -4716)
                        else
                            hrp.CFrame = tail.CFrame
                            pcall(function() cutlass:Activate() end)
                        end
                    end
                end
                task.wait(0.016)
            end
        end)
    end
})
