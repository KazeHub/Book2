local isToggledMonsterSeq = false
local mainTaskMonsterSeq = nil
local activeTweenMonsterSeq = nil

local function tweenToMonsterSeq(rootPart, targetCFrame, duration)
    if not rootPart or not rootPart.Parent then return end
    if activeTweenMonsterSeq then
        activeTweenMonsterSeq:Cancel()
        activeTweenMonsterSeq = nil
    end
    local tweenInfo = TweenInfo.new(duration or 0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    activeTweenMonsterSeq = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    activeTweenMonsterSeq:Play()
end

local function triggerPrompt(prompt)
    if not prompt or not prompt.Enabled then return false end
    if fireproximityprompt then fireproximityprompt(prompt)
    else
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration or 0.1)
        prompt:InputHoldEnd()
    end
    return true
end

local function checkPrompt(monsterModel, hrp)
    if hrp then
        local foundPrompt = hrp:FindFirstChildOfClass("ProximityPrompt") or monsterModel:FindFirstChildOfClass("ProximityPrompt", true)
        if foundPrompt and foundPrompt.Enabled and foundPrompt.Parent then
            return foundPrompt
        end
    end
    return nil
end

local function isBossHealthZero()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local s4 = playerGui:FindFirstChild("S4")
    if not s4 then return false end
    local health = s4:FindFirstChild("Health")
    if not health then return false end
    local front = health:FindFirstChild("Front")
    if not front then return false end
    return front.AbsoluteSize.X <= 0
end

local monsterTargets = {
    { folder = "Monster2", name = "Rin2" },
    { folder = "Monster3", name = "Tenome2" },
    { folder = "Monster4", name = "Tsukiya2" }
}

local function getMonsterReferences(targetInfo)
    local section4 = Workspace:FindFirstChild("Section4")
    if not section4 then return nil, nil, nil end
    local monsterFolder = section4:FindFirstChild(targetInfo.folder)
    if not monsterFolder then return nil, nil, nil end
    local model = monsterFolder:FindFirstChild(targetInfo.name)
    if not model then return nil, nil, nil end
    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    local hitBox = model:FindFirstChild("Hitbox") or hrp
    return model, hrp, hitBox
end

local function runTripleMonsterSequence()
    while isToggledMonsterSeq do
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")

        if not rootPart or not humanoid then 
            task.wait(0.5)
            continue 
        end

        enableFloat(rootPart)
        local waitCFrame = CFrame.new(30, 126, -2868)

        while isToggledMonsterSeq and not isBossHealthZero() do
            currentHoverCFrame = waitCFrame
            rootPart.CFrame = waitCFrame
            task.wait(0.3)
        end

        if not isToggledMonsterSeq then break end

        if Window and Window.Notify then
            Window:Notify({
                Title = "Kill Enzukai Ryu",
                Content = "Enzukai-Ryu defeated! Starting 3 Monsters sequence...",
                Duration = 5
            })
        end

        task.wait(0.5)

        for _, targetInfo in ipairs(monsterTargets) do
            if not isToggledMonsterSeq then break end

            local monsterModel, hrp, hitBox = getMonsterReferences(targetInfo)

            if monsterModel and hrp and hitBox then
                local standPos = (hrp.CFrame * CFrame.new(0, 0, 15)).Position
                local targetCFrame = CFrame.lookAt(standPos, hitBox.Position)
                rootPart.CFrame = targetCFrame
                currentHoverCFrame = targetCFrame
                tweenToMonsterSeq(rootPart, targetCFrame, 0.2)

                local promptInstance = nil
                local spiritBow = equipSpiritBow(character, humanoid)
                local remoteEvent = spiritBow and spiritBow:FindFirstChild("RemoteEvent")
                local startTime = tick()

                while isToggledMonsterSeq and not promptInstance and (tick() - startTime) < 25 do
                    promptInstance = checkPrompt(monsterModel, hrp)
                    if promptInstance then break end

                    if remoteEvent then
                        remoteEvent:FireServer(0, true)
                        local elapsed = 0
                        while elapsed < 1.50 and isToggledMonsterSeq do
                            task.wait(0.05)
                            elapsed = elapsed + 0.05

                            if hrp and hrp:IsA("BasePart") and hitBox then
                                local updatedStandPos = (hrp.CFrame * CFrame.new(0, 0, 15)).Position
                                local updatedBackCFrame = CFrame.lookAt(updatedStandPos, hitBox.Position)
                                currentHoverCFrame = updatedBackCFrame
                                tweenToMonsterSeq(rootPart, updatedBackCFrame, 0.1)
                            end

                            promptInstance = checkPrompt(monsterModel, hrp)
                            if promptInstance then break end
                        end

                        if not isToggledMonsterSeq or promptInstance then break end

                        local exactAimDirection = (hitBox.Position - rootPart.Position).Unit
                        remoteEvent:FireServer(0, false, exactAimDirection)
                        task.wait(0.2)
                    else
                        if hrp and hrp:IsA("BasePart") and hitBox then
                            local updatedStandPos = (hrp.CFrame * CFrame.new(0, 0, 20)).Position
                            local updatedBackCFrame = CFrame.lookAt(updatedStandPos, hitBox.Position)
                            currentHoverCFrame = updatedBackCFrame
                            tweenToMonsterSeq(rootPart, updatedBackCFrame, 0.1)
                        end
                        task.wait(0.1)
                    end
                    promptInstance = checkPrompt(monsterModel, hrp)
                end

                if isToggledMonsterSeq and promptInstance then
                    local promptStartTime = tick()
                    while isToggledMonsterSeq and (tick() - promptStartTime) < 5 do
                        if not promptInstance or not promptInstance.Parent or not promptInstance.Enabled then break end
                        if hrp and hrp:IsA("BasePart") then
                            rootPart.CFrame = hrp.CFrame
                            currentHoverCFrame = hrp.CFrame
                        end
                        triggerPrompt(promptInstance)
                        task.wait(0.15)
                    end
                end

                local waitStart = tick()
                while isToggledMonsterSeq and monsterModel and monsterModel.Parent and (tick() - waitStart) < 10 do
                    if hrp and hrp:IsA("BasePart") then
                        rootPart.CFrame = hrp.CFrame
                        currentHoverCFrame = hrp.CFrame
                    end
                    task.wait(0.2)
                end
                task.wait(0.3)
            end
        end
        break
    end

    disableFloat()
    isToggledMonsterSeq = false
end

StreetTokyo:Toggle({
    Title = "Auto 3 Monsters",
    Locked = false,
    Description = "",
    Default = false,
    Callback = function(state)
        isToggledMonsterSeq = state
        if isToggledMonsterSeq then
            mainTaskMonsterSeq = task.spawn(runTripleMonsterSequence)
        else
            disableFloat()
            if mainTaskMonsterSeq then
                task.cancel(mainTaskMonsterSeq)
                mainTaskMonsterSeq = nil
            end
        end
    end
})

local DODGE_WAIT_TIME = 4.5
local HEAD_X_THRESHOLD = -200
local isToggledRyujin = false
local isDodging = false
local dodgeArmed = true
local mainTaskRyujin = nil
local positionTrackerConnection = nil

local cachedSection5, cachedFinalForm, cachedRyujin, cachedHeadHitBox, cachedSpawnPoint

local function updateCachedObjects(force)
	if force or not cachedSection5 or not cachedSection5.Parent then
		cachedSection5 = Workspace:FindFirstChild("Section5")
	end
	if not cachedSection5 then return false end

	if force or not cachedSpawnPoint or not cachedSpawnPoint.Parent then
		cachedSpawnPoint = cachedSection5:FindFirstChild("TeleportAndSetSpawn", true)
	end
	if force or not cachedFinalForm or not cachedFinalForm.Parent then
		cachedFinalForm = cachedSection5:FindFirstChild("FinalForm", true)
	end
	if not cachedFinalForm then return false end

	if force or not cachedRyujin or not cachedRyujin.Parent then
		cachedRyujin = cachedFinalForm:FindFirstChild("EnzukaiRyujin", true)
	end
	if not cachedRyujin then return false end

	if force or not cachedHeadHitBox or not cachedHeadHitBox.Parent then
		cachedHeadHitBox = cachedRyujin:FindFirstChild("HeadHitBox", true) or cachedRyujin:FindFirstChild("Hitbox", true)
		if not cachedHeadHitBox and cachedRyujin:IsA("Model") then
			cachedHeadHitBox = cachedRyujin.PrimaryPart
		end
	end
	return true
end

local function clearCache()
	cachedSection5, cachedFinalForm, cachedRyujin, cachedHeadHitBox, cachedSpawnPoint = nil, nil, nil, nil, nil
end

local function performDodge()
	if not isToggledRyujin or isDodging or not dodgeArmed then return end
	isDodging = true
	dodgeArmed = false

	local character = LocalPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	updateCachedObjects()
	local spawnPt = cachedSpawnPoint

	local spawnCFrame = nil
	if spawnPt then
		if spawnPt:IsA("BasePart") then spawnCFrame = spawnPt.CFrame
		elseif spawnPt:IsA("Model") then spawnCFrame = spawnPt:GetPivot() end
	end

	if rootPart and spawnCFrame then
		currentHoverCFrame = spawnCFrame
		rootPart.CFrame = spawnCFrame
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		task.wait(DODGE_WAIT_TIME)
	end
	isDodging = false
end

local function startPositionTracker()
	if positionTrackerConnection then positionTrackerConnection:Disconnect() end
	positionTrackerConnection = RunService.Heartbeat:Connect(function()
		if not isToggledRyujin then return end
		updateCachedObjects()
		local hitbox = cachedHeadHitBox
		if not hitbox or not hitbox.Parent then
			updateCachedObjects(true)
			hitbox = cachedHeadHitBox
		end
		if not hitbox or not hitbox:IsA("BasePart") then return end

		local x = hitbox.Position.X
		if x > HEAD_X_THRESHOLD + 20 then dodgeArmed = true end
		if x <= HEAD_X_THRESHOLD and dodgeArmed and not isDodging then
			task.spawn(performDodge)
		end
	end)
end

local function stopPositionTracker()
	if positionTrackerConnection then
		positionTrackerConnection:Disconnect()
		positionTrackerConnection = nil
	end
end

local function runWeakPointPhaseRyujin(character, humanoid, rootPart, activeModel, iconGui)
	local bow = equipSpiritBow(character, humanoid)
	if not bow then return end
	local remote = bow:FindFirstChild("RemoteEvent")
	if not remote then return end

	enableFloat(rootPart)
	local eyeNames = {"EyeA", "EyeB", "EyeC", "EyeD", "EyeE"}
	local offsets = {CFrame.new(0, 30, 25), CFrame.new(25, 30, 0), CFrame.new(-25, 30, 0), CFrame.new(0, 30, -25)}

	for _, eyeName in ipairs(eyeNames) do
		if not isToggledRyujin or isDodging then break end
		local eye = activeModel:FindFirstChild(eyeName, true)
		if eye and eye:IsA("BasePart") then
			local offsetIndex = 1
			while isToggledRyujin and not isDodging and eye.Parent and eye.Transparency == 0
				and iconGui and iconGui.Parent and iconGui.Enabled do

				local stand = eye.CFrame * offsets[offsetIndex]
				currentHoverCFrame = CFrame.lookAt(stand.Position, eye.Position)
				rootPart.CFrame = currentHoverCFrame

				remote:FireServer(0, true)
				
				local elapsed = 0
				while elapsed < 1.5 and isToggledRyujin and not isDodging and eye.Parent and eye.Transparency == 0 do
					task.wait(0.05)
					elapsed = elapsed + 0.05
					currentHoverCFrame = CFrame.lookAt((eye.CFrame * offsets[offsetIndex]).Position, eye.Position)
					rootPart.CFrame = currentHoverCFrame
				end

				if not isToggledRyujin or isDodging then break end
				if eye.Parent and eye.Transparency == 0 then
					local aim = getPerfectAimDirection(bow, eye, rootPart, 300)
					remote:FireServer(0, false, aim)
				end
				task.wait(0.2)
				offsetIndex = (offsetIndex % #offsets) + 1
			end
		end
	end
end

local function runBossPhaseRyujin(character, humanoid, rootPart)
	updateCachedObjects()
	local headHitBox = cachedHeadHitBox
	if not headHitBox or not headHitBox.Parent then return end

	local bow = equipSpiritBow(character, humanoid)
	if not bow then return end
	local remote = bow:FindFirstChild("RemoteEvent")
	if not remote then return end

	enableFloat(rootPart)

	while isToggledRyujin and not isDodging and headHitBox and headHitBox.Parent do
		if findActiveWeakPoint() then break end

		local rightPos = (headHitBox.CFrame * CFrame.new(15, 0, 0)).Position
		local rightCFrame = CFrame.lookAt(rightPos, headHitBox.Position)

		currentHoverCFrame = rightCFrame
		tweenTo(rootPart, rightCFrame, 0.2)
		remote:FireServer(0, true)

		local elapsed = 0
		while elapsed < 1.5 and isToggledRyujin and not isDodging and not findActiveWeakPoint() do
			if not headHitBox or not headHitBox.Parent then break end
			local pos = (headHitBox.CFrame * CFrame.new(15, 0, 0)).Position
			local cf = CFrame.lookAt(pos, headHitBox.Position)
			currentHoverCFrame = cf
			tweenTo(rootPart, cf, 0.1)
			task.wait(0.05)
			elapsed = elapsed + 0.05
		end

		if not isToggledRyujin or isDodging or findActiveWeakPoint() then break end
		if headHitBox and headHitBox.Parent then
			local aim = getPerfectAimDirection(bow, headHitBox, rootPart, 300)
			remote:FireServer(0, false, aim)
		end
		task.wait(0.2)
	end
end

local function runSection5Automation()
	startPositionTracker()

	while isToggledRyujin do
		if isDodging then
			task.wait(0.1)
			continue
		end

		local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local rootPart = character:FindFirstChild("HumanoidRootPart")

		if not humanoid or not rootPart or humanoid.Health <= 0 then
			task.wait(0.5)
			continue
		end

		updateCachedObjects()
		local activeModel, iconGui = findActiveWeakPoint()

		if activeModel and iconGui then
			runWeakPointPhaseRyujin(character, humanoid, rootPart, activeModel, iconGui)
		else
			runBossPhaseRyujin(character, humanoid, rootPart)
		end

		task.wait(0.1)
	end

	stopPositionTracker()
	disableFloat()
end

StreetTokyo:Toggle({
	Title = "Auto Enzukai Ryujin",
	Locked = false,
	Description = "Final Form",
	Default = false,
	Callback = function(state)
		isToggledRyujin = state
		isDodging = false
		dodgeArmed = true

		if isToggledRyujin then
			clearCache()
			mainTaskRyujin = task.spawn(function()
				pcall(runSection5Automation)
			end)
		else
			isToggledRyujin = false
			stopPositionTracker()
			disableFloat()
			if mainTaskRyujin then
				task.cancel(mainTaskRyujin)
				mainTaskRyujin = nil
			end
		end
	end
})
