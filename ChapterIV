local PROXIMITY_RANGE = 15

local function clearYenEsp()
	if yenEspTask then task.cancel(yenEspTask) yenEspTask = nil end
	for _, c in ipairs(yenFolderConns) do pcall(function() c:Disconnect() end) end
	yenFolderConns = {}
	for item, data in pairs(yenEspHolders) do
		if data then pcall(function() if data.Highlight then data.Highlight:Destroy() end if data.Billboard then data.Billboard:Destroy() end end) end
	end
	yenEspHolders = {}
end

local function addYenEspToItem(item)
	if not item or yenEspHolders[item] then return end
	local target = getValidPart(item)
	if not target then return end
	pcall(function()
		local hl = Instance.new("Highlight")
		hl.Name = "YenHighlight" hl.Adornee = item hl.FillColor = Color3.fromRGB(255, 215, 0) hl.OutlineColor = Color3.fromRGB(0, 0, 0)
		hl.FillTransparency = 0.4 hl.OutlineTransparency = 0 hl.Parent = item
		local bb = Instance.new("BillboardGui")
		bb.Name = "YenTextBillboard" bb.Adornee = target bb.Size = UDim2.new(0, 80, 0, 24) bb.StudsOffset = Vector3.new(0, 2, 0) bb.AlwaysOnTop = true bb.Parent = target
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.new(1, 0, 1, 0) tl.BackgroundTransparency = 1 tl.TextColor3 = Color3.fromRGB(255, 215, 0) tl.TextSize = 12 tl.Font = Enum.Font.SourceSansBold tl.Text = "Yen" tl.Parent = bb
		local stroke = Instance.new("UIStroke") stroke.Color = Color3.fromRGB(0, 0, 0) stroke.Thickness = 1.5 stroke.Parent = tl
		yenEspHolders[item] = {Highlight = hl, Billboard = bb, TextLabel = tl, Part = target}
	end)
end

local function removeYenEspFromItem(item)
	local data = yenEspHolders[item]
	if data then
		pcall(function() if data.Highlight then data.Highlight:Destroy() end if data.Billboard then data.Billboard:Destroy() end end)
		yenEspHolders[item] = nil
	end
end

local function startYenEsp()
	clearYenEsp()
	local yenFolder = Workspace:FindFirstChild("MimicCurrencySpawns") and Workspace.MimicCurrencySpawns:FindFirstChild("Yen")
	if yenFolder then
		for _, item in ipairs(yenFolder:GetChildren()) do if isEspToggled then addYenEspToItem(item) end end
		yenFolderConns[#yenFolderConns + 1] = yenFolder.ChildAdded:Connect(function(item) if isEspToggled then task.wait(0.1) addYenEspToItem(item) end end)
		yenFolderConns[#yenFolderConns + 1] = yenFolder.ChildRemoved:Connect(removeYenEspFromItem)
	end
	yenEspTask = task.spawn(function()
		while isEspToggled do
			local root = getHRP()
			for item, data in pairs(yenEspHolders) do
				if item and item.Parent and data.Part and data.Part.Parent and data.TextLabel then
					data.TextLabel.Text = root and ("Yen [%sm]"):format(math.floor((data.Part.Position - root.Position).Magnitude)) or "Yen"
				else
					removeYenEspFromItem(item)
				end
			end
			task.wait(0.35)
		end
	end)
end

local function startAutoPrompt()
	if autoPromptTask then return end
	autoPromptTask = task.spawn(function()
		while isAutoPromptToggled do
			local root = getHRP()
			local yenFolder = Workspace:FindFirstChild("MimicCurrencySpawns") and Workspace.MimicCurrencySpawns:FindFirstChild("Yen")
			if root and yenFolder then
				for _, item in ipairs(yenFolder:GetChildren()) do
					if not isAutoPromptToggled then break end
					local part = getValidPart(item)
					if part and (part.Position - root.Position).Magnitude <= PROXIMITY_RANGE then
						local prompt = item:FindFirstChildOfClass("ProximityPrompt") or item:FindFirstChild("ProximityPrompt", true)
						if prompt then pcall(function() prompt.HoldDuration = 0 fireproximityprompt(prompt, 0) end) end
					end
				end
			end
			task.wait(0.2)
		end
		autoPromptTask = nil
	end)
end

