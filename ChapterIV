local CharCache = {Character = nil, Humanoid = nil, HumanoidRootPart = nil, BaseParts = {}}
local function refreshCharCache(force)
	local char = LocalPlayer.Character
	if not force and char == CharCache.Character and CharCache.HumanoidRootPart and CharCache.HumanoidRootPart.Parent then
		return CharCache.Character, CharCache.Humanoid, CharCache.HumanoidRootPart
	end
	CharCache.Character = char
	CharCache.Humanoid = char and char:FindFirstChildOfClass("Humanoid")
	CharCache.HumanoidRootPart = char and char:FindFirstChild("HumanoidRootPart")
	CharCache.BaseParts = {}
	if char then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then CharCache.BaseParts[#CharCache.BaseParts + 1] = p end
		end
	end
	return CharCache.Character, CharCache.Humanoid, CharCache.HumanoidRootPart
end
LocalPlayer.CharacterAdded:Connect(function() task.defer(function() task.wait(0.1) refreshCharCache(true) end) end)
LocalPlayer.CharacterRemoving:Connect(function() CharCache.Character, CharCache.Humanoid, CharCache.HumanoidRootPart, CharCache.BaseParts = nil, nil, nil, {} end)
refreshCharCache(true)

local function getHRP() local _, _, hrp = refreshCharCache() return hrp end
local function getCharacter() return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() end
local function firePrompt(obj)
	if not obj then return end
	local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt and prompt.Enabled then
		if fireproximityprompt then fireproximityprompt(prompt) else prompt:InputHoldBegin() task.wait(prompt.HoldDuration or 0) prompt:InputHoldEnd() end
	end
end
local function tpTo(cf)
	local hrp = getHRP()
	if hrp then hrp.CFrame = typeof(cf) == "CFrame" and cf or CFrame.new(cf) end
end
local function getValidPart(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

