local TargetFlySpeed, FLY_ENABLED, flyTask = 16, false, nil
Player:Slider({Title = "Fly Speed", Min = 16, Max = 100, Default = 16, Callback = function(v) TargetFlySpeed = v end})
Player:Toggle({
	Title = "Enable Fly", Default = false,
	Callback = function(state)
		FLY_ENABLED = state
		if flyTask then task.cancel(flyTask) flyTask = nil end
		local _, hum, hrp = refreshCharCache()
		if hum then hum.PlatformStand = false end
		if hrp then hrp.Anchored = false hrp.AssemblyAngularVelocity = Vector3.zero hrp.AssemblyLinearVelocity = Vector3.zero end
		if state then
			local cam = Workspace.CurrentCamera
			flyTask = task.spawn(function()
				while FLY_ENABLED do
					local _, humanoid, root = refreshCharCache()
					if root and humanoid then
						local md = humanoid.MoveDirection
						if md.Magnitude > 0 then
							root.Anchored = false
							root.AssemblyLinearVelocity = Vector3.zero
							root.AssemblyAngularVelocity = Vector3.zero
							local rel = cam.CFrame:VectorToObjectSpace(md)
							local dir = (cam.CFrame.RightVector * rel.X) + (cam.CFrame.LookVector * -rel.Z)
							if dir.Magnitude > 0 then dir = dir.Unit end
							root.CFrame = CFrame.lookAlong(root.Position, dir) + (dir * (TargetFlySpeed * 0.03))
						else
							root.AssemblyLinearVelocity = Vector3.zero
							root.AssemblyAngularVelocity = Vector3.zero
							root.Anchored = true
						end
					end
					task.wait(0.03)
				end
			end)
		end
	end
})

